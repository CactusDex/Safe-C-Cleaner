<Window
    x:Class="SafeCCleaner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Safe C: Cleaner">

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        CompactPaneLength="52"
        IsPaneToggleButtonVisible="True"
        SelectionChanged="Navigation_SelectionChanged"
        ScrollViewer.VerticalScrollBarVisibility="Hidden">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Обзор" Tag="overview" IsSelected="True">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Быстрая очистка" Tag="quick">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Глубокая очистка" Tag="deep">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Диск и рост" Tag="disk">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Анализатор диска" Tag="analyzer">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Developer Storage" Tag="developer">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="История очисток" Tag="history">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Настройки" Tag="settings">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="О программе" Tag="about">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- OVERVIEW -->
            <ScrollViewer x:Name="OverviewPage" Grid.Row="0">
                <StackPanel Margin="32,26,32,26" Spacing="18" MaxWidth="1050" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Safe C: Cleaner" FontSize="30" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="OverviewScanButton" Grid.Column="1" Content="{Binding ScanButtonText}" Click="Scan_Click"
                                IsEnabled="{Binding CanStartScan}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Диск C:" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DriveSummary}" Opacity="0.78" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DriveUsedPercent}" Height="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" MinWidth="210" VerticalAlignment="Center">
                                <TextBlock Text="Безопасно можно освободить" Opacity="0.68" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SafeReclaimableText}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Быстрая безопасная очистка" FontSize="20" FontWeight="SemiBold" />
                                    <Button Style="{StaticResource InfoIconButtonStyle}" ToolTipService.ToolTip="Что входит в Быструю очистку" AutomationProperties.Name="Информация о Быстрой очистке">
                                        <FontIcon Glyph="&#xE946;" FontSize="13"/>
                                        <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><TextBlock Width="350" Text="SAFE-категории: временные файлы пользователя и Windows, кэши шейдеров, миниатюр и браузеров, а также старые отчёты об ошибках. Конкретный состав и описание каждой категории доступны в разделе «Быстрая очистка»." TextWrapping="Wrap"/></Flyout></Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Очистить безопасное" Click="QuickCleanSafe_Click"
                                    VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="22" VerticalAlignment="Top" Margin="2,2,2,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Последняя операция" Opacity="0.62" FontSize="12" />
                                <TextBlock Text="{Binding LastCleanupSummary}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastCleanupDetail}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Почему C: заполняется" FontWeight="SemiBold" FontSize="17" />
                                <TextBlock Text="{Binding BiggestGrowthText}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BiggestGrowthDetail}" Opacity="0.68" TextWrapping="Wrap" />
                                <Button Content="Открыть анализ" Click="NavigateToDisk_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Deep Clean" FontWeight="SemiBold" FontSize="17" />
                                    <Button Style="{StaticResource InfoIconButtonStyle}" ToolTipService.ToolTip="О системной очистке" AutomationProperties.Name="Информация о Deep Clean">
                                        <FontIcon Glyph="&#xE946;" FontSize="13"/>
                                        <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><TextBlock Width="350" Text="Системные операции требуют явного подтверждения и выполняются через UAC и штатные механизмы Windows; защищённые системные каталоги вручную не удаляются." TextWrapping="Wrap"/></Flyout></Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding DeepPotentialText}" FontSize="22" FontWeight="SemiBold" />
                                <Button Content="Открыть Deep Clean" Click="NavigateToDeep_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Последнее сканирование" Opacity="0.58" FontSize="11"/>
                                <TextBlock Text="{Binding LastScanTimeText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScanResultSummary}" Opacity="0.68" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding LastScanDurationText}" VerticalAlignment="Center" Opacity="0.72"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- QUICK CLEAN -->
            <Grid x:Name="QuickCleanPage" Grid.Row="0" Visibility="Collapsed" Margin="28,20,28,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Быстрая очистка" FontSize="28" FontWeight="SemiBold" />
                        <Button Style="{StaticResource InfoIconButtonStyle}"
                                ToolTipService.ToolTip="Что удаляет Быстрая очистка"
                                AutomationProperties.Name="Информация о Быстрой очистке">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="360" Spacing="7">
                                        <TextBlock Text="Быстрая очистка" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="SAFE-категории содержат пересоздаваемые временные данные и могут очищаться без дополнительного подтверждения. ADVANCED-категории требуют явного подтверждения." TextWrapping="Wrap" />
                                        <TextBlock Text="Корзина, дампы приложений и системные BSOD-дампы не выбираются автоматически." Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <RadioButton Content="Все" Tag="all" GroupName="CleanupFilter" IsChecked="True" Checked="CleanupFilter_Checked" />
                        <RadioButton Content="SAFE" Tag="safe" GroupName="CleanupFilter" Checked="CleanupFilter_Checked" />
                        <RadioButton Content="ADVANCED" Tag="advanced" GroupName="CleanupFilter" Checked="CleanupFilter_Checked" />
                    </StackPanel>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding VisibleCleanupItems}" SelectionMode="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,5" Padding="12,7" CornerRadius="10" MinHeight="52"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,2,0" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Style="{StaticResource InfoIconButtonStyle}" Width="24" Height="24" MinWidth="24" MinHeight="24"
                                                ToolTipService.ToolTip="{Binding Description}"
                                                AutomationProperties.Name="Описание категории очистки">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" />
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                    <StackPanel Width="360" Spacing="7">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <TextBlock Text="Режим:" Opacity="0.68" />
                                                            <TextBlock Text="{Binding RiskText}" Opacity="0.68" />
                                                            <TextBlock Text="{Binding ElevationText}" Opacity="0.68" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding WarningVisibility}">
                                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Warning}" Opacity="0.76" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="330" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBlock Text="{Binding RiskText}" Opacity="0.56" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ElevationText}" Visibility="{Binding ElevationVisibility}"
                                                   Opacity="0.56" FontSize="11" VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Opacity="0.62"
                                                  Visibility="{Binding WarningVisibility}"
                                                  ToolTipService.ToolTip="{Binding Warning}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="94">
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding FileCountText}" Opacity="0.56" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="Очистить" Click="CleanSingle_Click" DataContext="{Binding}"
                                            IsEnabled="{Binding CanClean}" MinWidth="86" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,9" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedCleanupSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedCleanupSizeText}" Opacity="0.68" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Очистить выбранное" Click="CleanSelected_Click"
                                IsEnabled="{Binding CanCleanSelected}" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- DEEP CLEAN -->
            <ScrollViewer x:Name="DeepCleanPage" Grid.Row="0" Visibility="Collapsed">
                <StackPanel Margin="32,26,32,28" Spacing="14" MaxWidth="1050" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Глубокая очистка" FontSize="28" FontWeight="SemiBold" />
                        <Button Style="{StaticResource InfoIconButtonStyle}"
                                ToolTipService.ToolTip="Что делает Глубокая очистка"
                                AutomationProperties.Name="Информация о Глубокой очистке">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="380" Spacing="7">
                                        <TextBlock Text="Глубокая очистка" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Системные операции выполняются через UAC и штатные механизмы Windows. Приложение не удаляет WinSxS или SoftwareDistribution вручную и не использует DISM /ResetBase." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Старые компоненты Windows" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="DISM /AnalyzeComponentStore → /StartComponentCleanup. /ResetBase никогда не используется."
                                           Opacity="0.68" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ComponentStoreStatusText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ComponentStoreDetailsText}" Margin="0,4,0,0" Opacity="0.62"
                                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Анализировать" Click="AnalyzeComponentStore_Click" />
                                <Button Content="Очистить" Click="CleanupComponentStore_Click" IsEnabled="{Binding ComponentCleanupEnabled}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Windows Update Cleanup" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="SAFE · UAC" FontSize="12" Opacity="0.58" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Удаляет устаревшие файлы обновлений только через встроенную категорию Windows Disk Cleanup."
                                           Opacity="0.68" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WindowsUpdateCleanupStatusText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Очистить обновления" Click="CleanWindowsUpdate_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Предыдущая установка Windows" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WindowsOldSizeText}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WindowsOldStatusText}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Удалить остатки обновления" Click="CleanWindowsOld_Click"
                                    IsEnabled="{Binding WindowsOldAvailable}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Delivery Optimization" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DeliveryOptimizationSizeText}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DeliveryOptimizationStatusText}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Очистить кэш" Click="CleanDeliveryOptimization_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Файл гибернации" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="ADVANCED" FontSize="12" Opacity="0.58" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding HiberfileSizeText}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HibernationStatusText}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Отключить" Click="DisableHibernate_Click" IsEnabled="{Binding HibernationEnabled}" />
                                <Button Content="Включить обратно" Click="EnableHibernate_Click" IsEnabled="{Binding HibernationRestoreEnabled}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Padding="16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock Text="Важно: Safe C: Cleaner не удаляет WinSxS/SoftwareDistribution вручную, не использует DISM /ResetBase и не трогает точки восстановления без отдельного будущего Expert Mode."
                                   TextWrapping="Wrap" Opacity="0.72" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- DISK / STORAGE INTELLIGENCE -->
            <Grid x:Name="DiskPage" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Margin="24,20,24,20" Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Storage Intelligence" FontSize="28" FontWeight="SemiBold" />
                                <Button Style="{StaticResource InfoIconButtonStyle}"
                                        ToolTipService.ToolTip="Что показывает Storage Intelligence"
                                        AutomationProperties.Name="Информация о Storage Intelligence">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="380" Spacing="7">
                                                <TextBlock Text="Storage Intelligence" FontWeight="SemiBold" FontSize="16" />
                                                <TextBlock Text="Сохраняет снимки занятого места на C:, сравнивает их между собой и показывает, какие отслеживаемые зоны выросли. Этот раздел ничего не удаляет." TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="{Binding RescanButtonText}" Click="Scan_Click" IsEnabled="{Binding CanStartScan}" />
                                <Button Content="Отмена" Click="CancelScan_Click" IsEnabled="{Binding IsScanning}" />
                            </StackPanel>
                        </Grid>

                        <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DriveUsedPercent}" Height="10" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="ЗАНЯТО" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding DriveUsedText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="СВОБОДНО" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding DriveFreeText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="ВСЕГО" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding DriveTotalText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="3"><TextBlock Text="1 ДЕНЬ" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding Trend1DayText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Trend1DayDetail}" Opacity="0.64" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Grid.Column="1" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="3"><TextBlock Text="7 ДНЕЙ" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding Trend7DayText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Trend7DayDetail}" Opacity="0.64" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Grid.Column="2" Padding="14" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="3"><TextBlock Text="30 ДНЕЙ" Opacity="0.55" FontSize="11"/><TextBlock Text="{Binding Trend30DayText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Trend30DayDetail}" Opacity="0.64" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
